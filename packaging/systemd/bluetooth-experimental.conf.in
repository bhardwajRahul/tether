# Exposes BlueZ's per-transport Bearer.LE1 interface, which carries the LE half
# of the iPhone bond that ANCS notification mirroring runs over.
#
# Not installed into bluetooth.service.d by the package: it changes how
# bluetoothd runs for everything on this machine, so putting it there is your
# call. `tether --bt-setup` prints the command.
#
# ExecStart must name the bluetoothd binary, and its path differs by distro.
# Configured here for this build; override with -DBLUETOOTHD_PATH=... .
[Service]
ExecStart=
ExecStart=@BLUETOOTHD_PATH@ --experimental
