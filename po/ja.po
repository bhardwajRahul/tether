msgstr "メッセージは送信されませんでした。"

#: src/cli/main.cpp
msgid "--port expects a number.\n"
msgstr "--port には数値を指定してください。\n"

#: src/cli/main.cpp
msgid "--timeout expects a number in milliseconds.\n"
msgstr "--timeout にはミリ秒単位の数値を指定してください。\n"

#: src/cli/main.cpp
msgid "Unknown action. Run tether --help for options\n"
msgstr ""
"不明な操作です。オプションを見るには tether --help を実行してください\n"

#: src/cli/main.cpp
msgid "  No tetherd instances found.\n"
msgstr "  tetherd のインスタンスは見つかりませんでした。\n"

#: src/cli/main.cpp
msgid "[new]"
msgstr "[新規]"

#: src/cli/main.cpp
msgid "[known]"
msgstr "[既知]"

