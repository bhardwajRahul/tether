#: src/cli/main.cpp
msgid "yes"
msgstr "はい"

#: src/cli/main.cpp
msgid "no"
msgstr "いいえ"

#: src/cli/main.cpp
msgid "Show this help message."
msgstr "このヘルプを表示します。"

#: src/cli/main.cpp
msgid "Print the tether version."
msgstr "tether のバージョンを表示します。"

#: src/cli/main.cpp
msgid "Retrieve the current Wayland clipboard text."
msgstr "Wayland のクリップボードの現在のテキストを取得します。"

#: src/cli/main.cpp
msgid "Take string input and copy it to the local Wayland clipboard."
msgstr ""
"入力からテキストを読み取り、ローカルの Wayland クリップボードにコピーします。"

#: src/cli/main.cpp
msgid "Send a file through tether."
msgstr "tether 経由でファイルを送信します。"

#: src/cli/main.cpp
msgid "Start the browser Native Messaging Host proxy loop."
msgstr "ブラウザの Native Messaging Host プロキシループを開始します。"

#: src/cli/main.cpp
msgid "Scan the local network for tetherd instances via mDNS."
msgstr "mDNS でローカルネットワーク上の tetherd を検索します。"

#: src/cli/main.cpp
msgid "Connect over TCP to daemon ip instead of UNIX Socket."
msgstr "UNIX ソケットではなく TCP でデーモンの ip に接続します。"

#: src/cli/main.cpp
msgid "Connect over TCP port (default 5134)."
msgstr "接続に使う TCP ポート (デフォルト 5134)。"

#: src/cli/main.cpp
msgid "Discovery scan duration in milliseconds (default 3000)."
msgstr "検索の実行時間 (ミリ秒、デフォルト 3000)。"

#: src/cli/main.cpp
msgid "List all paired connection devices."
msgstr "ペアリング済みのデバイスをすべて一覧表示します。"

#: src/cli/main.cpp
msgid "Show the one-time system setup Bluetooth still needs."
msgstr "Bluetooth にまだ必要な一度きりのシステム設定を表示します。"

#: src/cli/main.cpp
msgid "Show Bluetooth adapter capability and delivery mode."
msgstr "Bluetooth アダプタの機能と配信モードを表示します。"

#: src/cli/main.cpp
msgid "List Bluetooth devices known to BlueZ."
msgstr "BlueZ が認識している Bluetooth デバイスを一覧表示します。"

#: src/cli/main.cpp
msgid "Show Bluetooth link and profile connection state."
msgstr "Bluetooth リンクとプロファイルの接続状態を表示します。"

#: src/cli/main.cpp
msgid "List iPhone message conversations."
msgstr "iPhone のメッセージの会話を一覧表示します。"

#: src/cli/main.cpp
msgid "Show messages in one conversation."
msgstr "1 つの会話のメッセージを表示します。"

#: src/cli/main.cpp
msgid "Reply in one conversation."
msgstr "1 つの会話で返信します。"

#: src/cli/main.cpp
msgid "Pair with an iPhone over Bluetooth."
msgstr "Bluetooth で iPhone とペアリングします。"

#: src/cli/main.cpp
msgid ""
"Ask the iPhone to authenticate directly instead of connecting first. Tether "
"falls back to this on its own; use it to skip straight there."
msgstr ""
"最初に接続するのではなく、iPhone に直接認証を要求します。Tether は自動的にこ"
"れにフォールバックします。すぐにこの方法を使う場合に指定します。"

#: src/cli/main.cpp
msgid "Remove a Bluetooth bond."
msgstr "Bluetooth のボンドを削除します。"

#: src/cli/main.cpp
msgid ""
"Re-advertise for ANCS so the iPhone shows its permission toggles again, "
"without removing the bond."
msgstr ""
"ANCS のためにアドバタイズし直し、ボンドを削除せずに iPhone が許可設定を再表示"
"するようにします。"

#: src/cli/main.cpp
msgid "Connect to the iPhone over Bluetooth, or stop."
msgstr "Bluetooth で iPhone に接続する、または停止します。"

#: src/cli/main.cpp
msgid "Turn notification mirroring on or off."
msgstr "通知のミラーリングをオンまたはオフにします。"

#: src/cli/main.cpp
msgid "Mirror notification titles and bodies, not just the app."
msgstr "アプリ名だけでなく、通知のタイトルと本文もミラーリングします。"

#: src/cli/main.cpp
msgid "Choose which Bluetooth controller to use."
msgstr "使用する Bluetooth アダプタを選択します。"

#: src/cli/main.cpp
msgid "List mirrored iPhone notifications."
msgstr "ミラーリングされた iPhone の通知を一覧表示します。"

#: src/cli/main.cpp
msgid "Print a redacted Bluetooth report for a bug report."
msgstr "バグ報告用に情報を伏せた Bluetooth レポートを出力します。"

#: src/cli/main.cpp
msgid ""
"Install the browser and mail extension's native messaging manifests for this "
"user. Needed only for portable builds; the distro packages install them "
"system-wide."
msgstr ""
"ブラウザーおよびメール拡張機能のネイティブメッセージングマニフェストをこの"
"ユーザー用にインストールします。ポータブルビルドでのみ必要です。ディストリ"
"ビューションのパッケージはシステム全体にインストールします。"

#: src/cli/main.cpp
msgid "Accept a pending pairing request locally."
msgstr "保留中のペアリング要求をローカルで承認します。"

#: src/cli/main.cpp
msgid "Send a pair_request over TCP to the daemon."
msgstr "TCP でデーモンに pair_request を送信します。"

#: src/cli/main.cpp
msgid "tether - Wayland companion CLI"
msgstr "tether - Wayland 用のコンパニオン CLI"

#: src/cli/main.cpp
msgid "Options:"
msgstr "オプション:"

#: src/cli/main.cpp
msgid "Examples:"
msgstr "例:"

#: src/cli/main.cpp
#, c-format
msgid "Installed %s\n"
msgstr "インストールしました: %s\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"No browser or mail client profile was found for this user, so nothing was "
"installed. Start Firefox, Thunderbird, or Chromium once and run this again.\n"
msgstr ""
"このユーザーのブラウザーまたはメールクライアントのプロファイルが見つからな"
"かったため、何もインストールされませんでした。Firefox、Thunderbird、または "
"Chromium を一度起動してから、もう一度実行してください。\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"Restart the browser or mail client to pick this up.\n"
msgstr ""
"\n"
"反映するにはブラウザーまたはメールクライアントを再起動してください。\n"

#: src/cli/main.cpp
msgid "Could not read Bluetooth status from the daemon.\n"
msgstr "デーモンから Bluetooth の状態を読み取れませんでした。\n"

#: src/cli/main.cpp
#, c-format
msgid "Bluetooth: unavailable (is bluetoothd running?)\n"
msgstr "Bluetooth: 利用できません (bluetoothd は動作していますか?)\n"

#: src/cli/main.cpp
#, c-format
msgid "Bluetooth setup is complete. Nothing to do.\n"
msgstr "Bluetooth の設定は完了しています。行うことはありません。\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"%zu step left before the iPhone Bluetooth features work:\n"
msgid_plural ""
"\n"
"%zu steps left before the iPhone Bluetooth features work:\n"
msgstr[0] ""
"\n"
"iPhone の Bluetooth 機能が動作するまで、あと %zu ステップ:\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"Re-run 'tether --bt-setup' afterwards to confirm.\n"
msgstr ""
"\n"
"その後 'tether --bt-setup' をもう一度実行して確認してください。\n"

