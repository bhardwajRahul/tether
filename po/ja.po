msgid "me"
msgstr "自分"

#: src/cli/main.cpp
msgid "them"
msgstr "相手"

#: src/cli/main.cpp
msgid "Daemon closed the connection before the message was sent.\n"
msgstr "メッセージが送信される前にデーモンが接続を閉じました。\n"

#: src/cli/main.cpp
#, c-format
msgid "Sent to %s\n"
msgstr "%s に送信しました\n"

#: src/cli/main.cpp src/gtk/messages_view.cpp
