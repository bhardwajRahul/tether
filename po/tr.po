#: src/cli/main.cpp
msgid ""
"Explicit framework connection locally rejected! Did you target explicitly "
"invalid TLS or is daemon broken?\n"
msgstr ""
"Açık çerçeve bağlantısı yerel olarak reddedildi! Açıkça geçersiz bir TLS mi "
"belirttiniz yoksa arka plan hizmeti mi bozuk?\n"

#: src/cli/main.cpp
#, c++-format
msgid "Transfer Failed: {}"
msgstr "Aktarım başarısız: {}"

#: src/cli/main.cpp
msgid "A thread key is required, e.g. --bt-messages tel:+15551234567\n"
msgstr "Bir konuşma anahtarı gerekli, örn. --bt-messages tel:+15551234567\n"

#: src/cli/main.cpp
msgid ""
"A conversation and a message are required, e.g. --bt-send tel:+15551234567 "
"\"hi\"\n"
msgstr ""
"Bir konuşma ve bir mesaj gerekli, örn. --bt-send tel:+15551234567 "
"\"merhaba\"\n"

#: src/cli/main.cpp
msgid "A Bluetooth address is required, e.g. --bt-pair AA:BB:CC:DD:EE:FF\n"
msgstr "Bir Bluetooth adresi gerekli, örn. --bt-pair AA:BB:CC:DD:EE:FF\n"

#: src/cli/main.cpp
msgid "Expected on or off, e.g. --bt-enable off\n"
msgstr "on ya da off bekleniyordu, örn. --bt-enable off\n"

#: src/cli/main.cpp
#, c-format
msgid "Bluetooth enabled.\n"
msgstr "Bluetooth etkinleştirildi.\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"Bluetooth disabled. Tether will not reconnect the iPhone. A link that is\n"
"already up stays up until you disconnect it or the phone goes out of range.\n"
msgstr ""
"Bluetooth devre dışı bırakıldı. Tether iPhone'a yeniden bağlanmayacak. "
"Zaten\n"
"kurulu olan bir bağlantı, siz kesene ya da telefon menzil dışına çıkana dek "
"sürer.\n"

#: src/cli/main.cpp
#, c++-format
msgid "Expected on or off, e.g. {} on\n"
msgstr "on ya da off bekleniyordu, örn. {} on\n"

#: src/cli/main.cpp
msgid "Notification contents enabled."
msgstr "Bildirim içeriği etkinleştirildi."

#: src/cli/main.cpp
msgid "Notification contents disabled."
msgstr "Bildirim içeriği devre dışı bırakıldı."

#: src/cli/main.cpp
msgid "Notification mirroring enabled."
msgstr "Bildirim yansıtma etkinleştirildi."

#: src/cli/main.cpp
msgid "Notification mirroring disabled."
msgstr "Bildirim yansıtma devre dışı bırakıldı."

#: src/cli/main.cpp
msgid "Expected a controller, e.g. --bt-adapter hci1, or --bt-adapter auto\n"
msgstr ""
"Bir bağdaştırıcı bekleniyordu, ör. --bt-adapter hci1 veya --bt-adapter auto\n"

#: src/cli/main.cpp
#, c++-format
msgid "No Bluetooth controller matches '{}'. Available:\n"
msgstr "'{}' ile eşleşen Bluetooth bağdaştırıcısı yok. Kullanılabilir:\n"

