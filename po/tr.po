msgstr "Bir konuşma anahtarı gerekli, örn. --bt-messages tel:+15551234567\n"

#: src/cli/main.cpp:854
msgid ""
"A conversation and a message are required, e.g. --bt-send tel:+15551234567 "
"\"hi\"\n"
msgstr ""
"Bir konuşma ve bir mesaj gerekli, örn. --bt-send tel:+15551234567 "
"\"merhaba\"\n"

#: src/cli/main.cpp:860
msgid "A Bluetooth address is required, e.g. --bt-pair AA:BB:CC:DD:EE:FF\n"
msgstr "Bir Bluetooth adresi gerekli, örn. --bt-pair AA:BB:CC:DD:EE:FF\n"

#: src/cli/main.cpp:868
