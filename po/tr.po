msgid "Could not read Bluetooth status from the daemon.\n"
msgstr "Bluetooth durumu arka plan hizmetinden okunamadı.\n"

#: src/cli/main.cpp
#, c-format
msgid "Bluetooth: unavailable (is bluetoothd running?)\n"
msgstr "Bluetooth: kullanılamıyor (bluetoothd çalışıyor mu?)\n"

#: src/cli/main.cpp
#, c-format
msgid "Bluetooth setup is complete. Nothing to do.\n"
msgstr "Bluetooth kurulumu tamamlandı. Yapılacak bir şey yok.\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"%zu step left before the iPhone Bluetooth features work:\n"
msgid_plural ""
"\n"
"%zu steps left before the iPhone Bluetooth features work:\n"
msgstr[0] ""
"\n"
"iPhone Bluetooth özellikleri çalışmadan önce %zu adım kaldı:\n"
msgstr[1] ""
"\n"
"iPhone Bluetooth özellikleri çalışmadan önce %zu adım kaldı:\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"Re-run 'tether --bt-setup' afterwards to confirm.\n"
msgstr ""
"\n"
"Sonrasında doğrulamak için 'tether --bt-setup' komutunu yeniden çalıştırın.\n"

