#: src/cli/main.cpp:125
msgid "yes"
msgstr "evet"

#: src/cli/main.cpp:125
msgid "no"
msgstr "hayır"

#: src/cli/main.cpp:166
msgid "Show this help message."
msgstr "Bu yardım iletisini göster."

#: src/cli/main.cpp:167
msgid "Retrieve the current Wayland clipboard text."
msgstr "Wayland panosundaki güncel metni al."

#: src/cli/main.cpp:168
msgid "Take string input and copy it to the local Wayland clipboard."
msgstr "Girişten metin oku ve yerel Wayland panosuna kopyala."

#: src/cli/main.cpp:169
msgid "Send a file through tether."
msgstr "tether üzerinden bir dosya gönder."

#: src/cli/main.cpp:170
msgid "Start the browser Native Messaging Host proxy loop."
msgstr "Tarayıcının Native Messaging Host vekil döngüsünü başlat."

#: src/cli/main.cpp:171
msgid "Scan the local network for tetherd instances via mDNS."
msgstr "Yerel ağı mDNS ile tetherd örnekleri için tara."

#: src/cli/main.cpp:172
msgid "Connect over TCP to daemon ip instead of UNIX Socket."
msgstr "UNIX soketi yerine TCP ile arka plan hizmetinin ip adresine bağlan."

#: src/cli/main.cpp:173
msgid "Connect over TCP port (default 5134)."
msgstr "Bağlantı için TCP kapısı (öntanımlı 5134)."

#: src/cli/main.cpp:174
msgid "Discovery scan duration in milliseconds (default 3000)."
msgstr "Keşif taramasının milisaniye cinsinden süresi (öntanımlı 3000)."

#: src/cli/main.cpp:175
msgid "List all paired connection devices."
msgstr "Eşleşmiş tüm aygıtları listele."

#: src/cli/main.cpp:176
msgid "Show the one-time system setup Bluetooth still needs."
msgstr "Bluetooth'un hâlâ gerektirdiği tek seferlik sistem kurulumunu göster."

#: src/cli/main.cpp:177
msgid "Show Bluetooth adapter capability and delivery mode."
msgstr "Bluetooth bağdaştırıcısının yeteneklerini ve teslim kipini göster."

#: src/cli/main.cpp:178
msgid "List Bluetooth devices known to BlueZ."
msgstr "BlueZ'in bildiği Bluetooth aygıtlarını listele."

#: src/cli/main.cpp:179
msgid "Show Bluetooth link and profile connection state."
msgstr "Bluetooth bağlantısının ve profillerin durumunu göster."

#: src/cli/main.cpp:180
msgid "List iPhone message conversations."
msgstr "iPhone'daki mesaj konuşmalarını listele."

#: src/cli/main.cpp:181
msgid "Show messages in one conversation."
msgstr "Bir konuşmadaki mesajları göster."

#: src/cli/main.cpp:182
msgid "Reply in one conversation."
msgstr "Bir konuşmada yanıtla."

#: src/cli/main.cpp:183
msgid "Pair with an iPhone over Bluetooth."
msgstr "Bluetooth üzerinden bir iPhone ile eşleş."

#: src/cli/main.cpp:184
msgid "Remove a Bluetooth bond."
msgstr "Bir Bluetooth bağını kaldır."

#: src/cli/main.cpp:186
msgid ""
"Re-advertise for ANCS so the iPhone shows its permission toggles again, "
"without removing the bond."
msgstr ""
"ANCS için yeniden duyuru yap; böylece iPhone izinlerini bağı kaldırmadan "
"yeniden gösterir."

#: src/cli/main.cpp:188
msgid "Connect to the iPhone over Bluetooth, or stop."
msgstr "Bluetooth üzerinden iPhone'a bağlan ya da dur."

#: src/cli/main.cpp:189
msgid "Turn notification mirroring on or off."
msgstr "Bildirim yansıtmayı aç ya da kapat."

#: src/cli/main.cpp:190
msgid "Mirror notification titles and bodies, not just the app."
msgstr ""
"Yalnızca uygulamayı değil, bildirimlerin başlığını ve metnini de yansıt."

#: src/cli/main.cpp:191
msgid "List mirrored iPhone notifications."
msgstr "Yansıtılan iPhone bildirimlerini listele."

#: src/cli/main.cpp:192
msgid "Print a redacted Bluetooth report for a bug report."
msgstr "Hata bildirimi için arındırılmış bir Bluetooth raporu yazdır."

#: src/cli/main.cpp:193
msgid "Accept a pending pairing request locally."
msgstr "Bekleyen bir eşleşme isteğini yerel olarak kabul et."

#: src/cli/main.cpp:194
msgid "Send a pair_request over TCP to the daemon."
msgstr "Arka plan hizmetine TCP üzerinden bir pair_request gönder."

#: src/cli/main.cpp:198
msgid "tether - Wayland companion CLI"
msgstr "tether - Wayland için yardımcı komut satırı aracı"

