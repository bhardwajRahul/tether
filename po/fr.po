#: src/cli/main.cpp:101
msgid ""
"tether - Wayland companion CLI\n"
"\n"
"Options:\n"
"  -h, --help               Show this help message.\n"
"  -g, --get-clipboard      Retrieve the current Wayland clipboard text.\n"
"  -s, --set-clipboard      Take string input and copy it to the local Wayland clipboard.\n"
"  -f, --send-file          Send a file through tether.\n"
"  -n, --native-host        Start the browser Native Messaging Host proxy loop.\n"
"  -d, --discover           Scan the local network for tetherd instances via mDNS.\n"
"  --host <ip>              Connect over TCP to daemon ip instead of UNIX Socket.\n"
"  --port <num>             Connect over TCP port (default 5134).\n"
"  --timeout <ms>           Discovery scan duration in milliseconds (default 3000).\n"
"  --list-devices           List all paired connection devices.\n"
"  --bt-setup               Show the one-time system setup Bluetooth still needs.\n"
"  --bt-status              Show Bluetooth adapter capability and delivery mode.\n"
"  --bt-devices             List Bluetooth devices known to BlueZ.\n"
"  --bt-connection          Show Bluetooth link and profile connection state.\n"
"  --bt-threads             List iPhone message conversations.\n"
"  --bt-messages <thread>   Show messages in one conversation.\n"
"  --bt-send <thread> <text>  Reply in one conversation.\n"
"  --bt-pair <addr>         Pair with an iPhone over Bluetooth.\n"
"  --bt-unpair <addr>       Remove a Bluetooth bond.\n"
"  --bt-solicit             Re-advertise for ANCS so the iPhone shows its permission\n"
"                           toggles again, without removing the bond.\n"
"  --bt-enable <on|off>     Connect to the iPhone over Bluetooth, or stop.\n"
"  --bt-ancs <on|off>       Turn notification mirroring on or off.\n"
"  --bt-ancs-content <on|off>  Mirror notification titles and bodies, not just the app.\n"
"  --bt-notifications       List mirrored iPhone notifications.\n"
"  --bt-diagnostics         Print a redacted Bluetooth report for a bug report.\n"
"  --accept <fingerprint>   Accept a pending pairing request locally.\n"
"  --pair                   Send a pair_request over TCP to the daemon.\n"
"\n"
"Examples:\n"
"  tether -g\n"
"  tether -g --host 127.0.0.1\n"
"  echo \"pipe\" | tether -s\n"
"  tether --discover\n"
"  tether --discover --timeout 5000\n"
"  tether -f ./report.pdf\n"
"  tether --accept 9a4f21...\n"
msgstr ""
"tether - utilitaire compagnon pour Wayland\n"
"\n"
"Options :\n"
"  -h, --help               Afficher cette aide.\n"
"  -g, --get-clipboard      Récupérer le texte actuel du presse-papiers Wayland.\n"
"  -s, --set-clipboard      Lire du texte sur l'entrée et le copier dans le presse-papiers Wayland local.\n"
"  -f, --send-file          Envoyer un fichier via tether.\n"
"  -n, --native-host        Démarrer la boucle proxy Native Messaging Host du navigateur.\n"
"  -d, --discover           Rechercher des instances de tetherd sur le réseau local via mDNS.\n"
"  --host <ip>              Se connecter en TCP à l'ip du démon au lieu de la socket UNIX.\n"
"  --port <num>             Port TCP de connexion (5134 par défaut).\n"
"  --timeout <ms>           Durée de la recherche en millisecondes (3000 par défaut).\n"
"  --list-devices           Lister tous les appareils appairés.\n"
"  --bt-setup               Afficher la configuration système ponctuelle encore requise par Bluetooth.\n"
"  --bt-status              Afficher les capacités de l'adaptateur Bluetooth et le mode de livraison.\n"
"  --bt-devices             Lister les appareils Bluetooth connus de BlueZ.\n"
"  --bt-connection          Afficher l'état du lien et des profils Bluetooth.\n"
"  --bt-threads             Lister les conversations de l'iPhone.\n"
"  --bt-messages <thread>   Afficher les messages d'une conversation.\n"
"  --bt-send <thread> <text>  Répondre dans une conversation.\n"
"  --bt-pair <addr>         Appairer un iPhone en Bluetooth.\n"
"  --bt-unpair <addr>       Supprimer un lien Bluetooth.\n"
"  --bt-solicit             Se réannoncer pour ANCS afin que l'iPhone affiche de nouveau ses\n"
"                           autorisations, sans supprimer le lien.\n"
"  --bt-enable <on|off>     Se connecter à l'iPhone en Bluetooth, ou arrêter.\n"
"  --bt-ancs <on|off>       Activer ou désactiver la duplication des notifications.\n"
"  --bt-ancs-content <on|off>  Dupliquer les titres et le contenu des notifications, pas seulement l'app.\n"
"  --bt-notifications       Lister les notifications dupliquées de l'iPhone.\n"
"  --bt-diagnostics         Afficher un rapport Bluetooth expurgé pour un rapport de bogue.\n"
"  --accept <fingerprint>   Accepter localement une demande d'appairage en attente.\n"
"  --pair                   Envoyer un pair_request au démon en TCP.\n"
"\n"
"Exemples :\n"
"  tether -g\n"
"  tether -g --host 127.0.0.1\n"
"  echo \"pipe\" | tether -s\n"
"  tether --discover\n"
"  tether --discover --timeout 5000\n"
"  tether -f ./report.pdf\n"
"  tether --accept 9a4f21...\n"

