msgid "A thread key is required, e.g. --bt-messages tel:+15551234567\n"
msgstr "En konversationsnyckel krävs, t.ex. --bt-messages tel:+15551234567\n"

#: src/cli/main.cpp
msgid ""
"A conversation and a message are required, e.g. --bt-send tel:+15551234567 "
"\"hi\"\n"
msgstr ""
"En konversation och ett meddelande krävs, t.ex. --bt-send tel:+15551234567 "
"\"hej\"\n"

#: src/cli/main.cpp
msgid "A Bluetooth address is required, e.g. --bt-pair AA:BB:CC:DD:EE:FF\n"
msgstr "En Bluetooth-adress krävs, t.ex. --bt-pair AA:BB:CC:DD:EE:FF\n"

#: src/cli/main.cpp
msgid "Expected on or off, e.g. --bt-enable off\n"
msgstr "Förväntade on eller off, t.ex. --bt-enable off\n"

