#: src/cli/main.cpp
msgid "yes"
msgstr "ja"

#: src/cli/main.cpp
msgid "no"
msgstr "nej"

#: src/cli/main.cpp
msgid "Show this help message."
msgstr "Visa den här hjälptexten."

#: src/cli/main.cpp
msgid "Retrieve the current Wayland clipboard text."
msgstr "Hämta den aktuella texten i Waylands urklipp."

#: src/cli/main.cpp
msgid "Take string input and copy it to the local Wayland clipboard."
msgstr ""
"Läs text från indata och kopiera den till det lokala Wayland-urklippet."

#: src/cli/main.cpp
msgid "Send a file through tether."
msgstr "Skicka en fil via tether."

#: src/cli/main.cpp
msgid "Start the browser Native Messaging Host proxy loop."
msgstr "Starta webbläsarens proxyslinga för Native Messaging Host."

#: src/cli/main.cpp
msgid "Scan the local network for tetherd instances via mDNS."
msgstr "Sök efter tetherd-instanser i det lokala nätverket via mDNS."

#: src/cli/main.cpp
msgid "Connect over TCP to daemon ip instead of UNIX Socket."
msgstr "Anslut via TCP till demonens ip i stället för UNIX-socketen."

#: src/cli/main.cpp
msgid "Connect over TCP port (default 5134)."
msgstr "TCP-port för anslutningen (standard 5134)."

#: src/cli/main.cpp
msgid "Discovery scan duration in milliseconds (default 3000)."
msgstr "Sökningens längd i millisekunder (standard 3000)."

#: src/cli/main.cpp
msgid "List all paired connection devices."
msgstr "Lista alla parkopplade enheter."

#: src/cli/main.cpp
msgid "Show the one-time system setup Bluetooth still needs."
msgstr ""
"Visa den engångsinställning av systemet som Bluetooth fortfarande behöver."

#: src/cli/main.cpp
msgid "Show Bluetooth adapter capability and delivery mode."
msgstr "Visa Bluetooth-adapterns kapacitet och leveransläge."

#: src/cli/main.cpp
msgid "List Bluetooth devices known to BlueZ."
msgstr "Lista de Bluetooth-enheter som BlueZ känner till."

#: src/cli/main.cpp
msgid "Show Bluetooth link and profile connection state."
msgstr "Visa status för Bluetooth-länken och profilerna."

#: src/cli/main.cpp
msgid "List iPhone message conversations."
msgstr "Lista iPhonens meddelandekonversationer."

#: src/cli/main.cpp
msgid "Show messages in one conversation."
msgstr "Visa meddelandena i en konversation."

#: src/cli/main.cpp
msgid "Reply in one conversation."
msgstr "Svara i en konversation."

#: src/cli/main.cpp
msgid "Pair with an iPhone over Bluetooth."
msgstr "Parkoppla en iPhone via Bluetooth."

#: src/cli/main.cpp
msgid ""
"Ask the iPhone to authenticate directly instead of connecting first. Tether "
"falls back to this on its own; use it to skip straight there."
msgstr ""
"Be iPhone autentisera direkt i stället för att ansluta först. Tether faller "
"tillbaka på detta av sig självt; använd för att gå direkt dit."

#: src/cli/main.cpp
msgid "Remove a Bluetooth bond."
msgstr "Ta bort en Bluetooth-bindning."

#: src/cli/main.cpp
msgid ""
"Re-advertise for ANCS so the iPhone shows its permission toggles again, "
"without removing the bond."
msgstr ""
"Annonsera igen för ANCS så att iPhonen visar sina behörigheter på nytt, utan "
"att bindningen tas bort."

#: src/cli/main.cpp
msgid "Connect to the iPhone over Bluetooth, or stop."
msgstr "Anslut till iPhonen via Bluetooth, eller sluta."

#: src/cli/main.cpp
msgid "Turn notification mirroring on or off."
msgstr "Slå på eller av spegling av aviseringar."

#: src/cli/main.cpp
msgid "Mirror notification titles and bodies, not just the app."
msgstr "Spegla aviseringarnas rubrik och text, inte bara appen."

#: src/cli/main.cpp
msgid "List mirrored iPhone notifications."
msgstr "Lista speglade iPhone-aviseringar."

#: src/cli/main.cpp
msgid "Print a redacted Bluetooth report for a bug report."
msgstr "Skriv ut en rensad Bluetooth-rapport för en felrapport."

#: src/cli/main.cpp
msgid "Accept a pending pairing request locally."
msgstr "Godkänn en väntande parkopplingsförfrågan lokalt."

#: src/cli/main.cpp
msgid "Send a pair_request over TCP to the daemon."
msgstr "Skicka en pair_request till demonen via TCP."

#: src/cli/main.cpp
msgid "tether - Wayland companion CLI"
msgstr "tether - Wayland-kompanjon för kommandoraden"

