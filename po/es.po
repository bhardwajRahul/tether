#: src/cli/main.cpp:100
msgid ""
"tether - Wayland companion CLI\n"
"\n"
"Options:\n"
"  -h, --help               Show this help message.\n"
"  -g, --get-clipboard      Retrieve the current Wayland clipboard text.\n"
"  -s, --set-clipboard      Take string input and copy it to the local "
"Wayland clipboard.\n"
"  -f, --send-file          Send a file through tether.\n"
"  -n, --native-host        Start the browser Native Messaging Host proxy "
"loop.\n"
"  -d, --discover           Scan the local network for tetherd instances via "
"mDNS.\n"
"  --host <ip>              Connect over TCP to daemon ip instead of UNIX "
"Socket.\n"
"  --port <num>             Connect over TCP port (default 5134).\n"
"  --timeout <ms>           Discovery scan duration in milliseconds (default "
"3000).\n"
"  --list-devices           List all paired connection devices.\n"
"  --bt-setup               Show the one-time system setup Bluetooth still "
"needs.\n"
"  --bt-status              Show Bluetooth adapter capability and delivery "
"mode.\n"
"  --bt-devices             List Bluetooth devices known to BlueZ.\n"
"  --bt-connection          Show Bluetooth link and profile connection "
"state.\n"
"  --bt-threads             List iPhone message conversations.\n"
"  --bt-messages <thread>   Show messages in one conversation.\n"
"  --bt-send <thread> <text>  Reply in one conversation.\n"
"  --bt-pair <addr>         Pair with an iPhone over Bluetooth.\n"
"  --bt-unpair <addr>       Remove a Bluetooth bond.\n"
"  --bt-solicit             Re-advertise for ANCS so the iPhone shows its "
"permission\n"
"                           toggles again, without removing the bond.\n"
"  --bt-enable <on|off>     Connect to the iPhone over Bluetooth, or stop.\n"
"  --bt-ancs <on|off>       Turn notification mirroring on or off.\n"
"  --bt-ancs-content <on|off>  Mirror notification titles and bodies, not "
"just the app.\n"
"  --bt-notifications       List mirrored iPhone notifications.\n"
"  --bt-diagnostics         Print a redacted Bluetooth report for a bug "
"report.\n"
"  --accept <fingerprint>   Accept a pending pairing request locally.\n"
"  --pair                   Send a pair_request over TCP to the daemon.\n"
"\n"
"Examples:\n"
"  tether -g\n"
"  tether -g --host 127.0.0.1\n"
"  echo \"pipe\" | tether -s\n"
"  tether --discover\n"
"  tether --discover --timeout 5000\n"
"  tether -f ./report.pdf\n"
"  tether --accept 9a4f21...\n"
msgstr ""
"tether - CLI complementaria para Wayland\n"
"\n"
"Opciones:\n"
"  -h, --help               Mostrar esta ayuda.\n"
"  -g, --get-clipboard      Obtener el texto actual del portapapeles de "
"Wayland.\n"
"  -s, --set-clipboard      Leer texto de la entrada y copiarlo al "
"portapapeles local de Wayland.\n"
"  -f, --send-file          Enviar un archivo a través de tether.\n"
"  -n, --native-host        Iniciar el bucle proxy del Native Messaging Host "
"del navegador.\n"
"  -d, --discover           Buscar instancias de tetherd en la red local "
"mediante mDNS.\n"
"  --host <ip>              Conectar por TCP a la ip del daemon en vez de al "
"socket UNIX.\n"
"  --port <num>             Puerto TCP de conexión (por omisión 5134).\n"
"  --timeout <ms>           Duración del escaneo de descubrimiento en "
"milisegundos (por omisión 3000).\n"
"  --list-devices           Listar todos los dispositivos emparejados.\n"
"  --bt-setup               Mostrar la configuración inicial del sistema que "
"aún necesita Bluetooth.\n"
"  --bt-status              Mostrar la capacidad del adaptador Bluetooth y el "
"modo de entrega.\n"
"  --bt-devices             Listar los dispositivos Bluetooth conocidos por "
"BlueZ.\n"
"  --bt-connection          Mostrar el estado del enlace y de los perfiles "
"Bluetooth.\n"
"  --bt-threads             Listar las conversaciones de mensajes del "
"iPhone.\n"
"  --bt-messages <thread>   Mostrar los mensajes de una conversación.\n"
"  --bt-send <thread> <text>  Responder en una conversación.\n"
"  --bt-pair <addr>         Emparejar con un iPhone por Bluetooth.\n"
"  --bt-unpair <addr>       Eliminar un vínculo Bluetooth.\n"
"  --bt-solicit             Volver a anunciarse para ANCS para que el iPhone "
"muestre de nuevo sus\n"
"                           permisos, sin eliminar el vínculo.\n"
"  --bt-enable <on|off>     Conectar con el iPhone por Bluetooth, o "
"detenerlo.\n"
"  --bt-ancs <on|off>       Activar o desactivar la duplicación de "
"notificaciones.\n"
"  --bt-ancs-content <on|off>  Duplicar títulos y contenido de las "
"notificaciones, no solo la app.\n"
"  --bt-notifications       Listar las notificaciones duplicadas del iPhone.\n"
"  --bt-diagnostics         Imprimir un informe Bluetooth redactado para un "
"informe de error.\n"
"  --accept <fingerprint>   Aceptar localmente una solicitud de "
"emparejamiento pendiente.\n"
"  --pair                   Enviar un pair_request al daemon por TCP.\n"
"\n"
"Ejemplos:\n"
"  tether -g\n"
"  tether -g --host 127.0.0.1\n"
"  echo \"pipe\" | tether -s\n"
"  tether --discover\n"
"  tether --discover --timeout 5000\n"
"  tether -f ./report.pdf\n"
"  tether --accept 9a4f21...\n"

