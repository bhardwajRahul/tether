#: src/cli/main.cpp
msgid "yes"
msgstr "sim"

#: src/cli/main.cpp
msgid "no"
msgstr "não"

#: src/cli/main.cpp
msgid "Show this help message."
msgstr "Mostrar esta mensagem de ajuda."

#: src/cli/main.cpp
msgid "Retrieve the current Wayland clipboard text."
msgstr "Obter o texto atual da área de transferência do Wayland."

#: src/cli/main.cpp
msgid "Take string input and copy it to the local Wayland clipboard."
msgstr ""
"Ler texto da entrada e copiá-lo para a área de transferência local do "
"Wayland."

#: src/cli/main.cpp
msgid "Send a file through tether."
msgstr "Enviar um arquivo pelo tether."

#: src/cli/main.cpp
msgid "Start the browser Native Messaging Host proxy loop."
msgstr "Iniciar o laço de proxy do Native Messaging Host do navegador."

#: src/cli/main.cpp
msgid "Scan the local network for tetherd instances via mDNS."
msgstr "Procurar instâncias do tetherd na rede local via mDNS."

#: src/cli/main.cpp
msgid "Connect over TCP to daemon ip instead of UNIX Socket."
msgstr "Conectar por TCP ao ip do daemon em vez do socket UNIX."

#: src/cli/main.cpp
msgid "Connect over TCP port (default 5134)."
msgstr "Porta TCP de conexão (padrão 5134)."

#: src/cli/main.cpp
msgid "Discovery scan duration in milliseconds (default 3000)."
msgstr "Duração da busca em milissegundos (padrão 3000)."

#: src/cli/main.cpp
msgid "List all paired connection devices."
msgstr "Listar todos os dispositivos pareados."

#: src/cli/main.cpp
msgid "Show the one-time system setup Bluetooth still needs."
msgstr "Mostrar a configuração única do sistema que o Bluetooth ainda precisa."

#: src/cli/main.cpp
msgid "Show Bluetooth adapter capability and delivery mode."
msgstr "Mostrar a capacidade do adaptador Bluetooth e o modo de entrega."

#: src/cli/main.cpp
msgid "List Bluetooth devices known to BlueZ."
msgstr "Listar os dispositivos Bluetooth conhecidos pelo BlueZ."

#: src/cli/main.cpp
msgid "Show Bluetooth link and profile connection state."
msgstr "Mostrar o estado do enlace Bluetooth e dos perfis."

#: src/cli/main.cpp
msgid "List iPhone message conversations."
msgstr "Listar as conversas de mensagens do iPhone."

#: src/cli/main.cpp
msgid "Show messages in one conversation."
msgstr "Mostrar as mensagens de uma conversa."

#: src/cli/main.cpp
msgid "Reply in one conversation."
msgstr "Responder em uma conversa."

#: src/cli/main.cpp
msgid "Pair with an iPhone over Bluetooth."
msgstr "Parear com um iPhone por Bluetooth."

#: src/cli/main.cpp
msgid ""
"Ask the iPhone to authenticate directly instead of connecting first. Tether "
"falls back to this on its own; use it to skip straight there."
msgstr ""

#: src/cli/main.cpp
msgid "Remove a Bluetooth bond."
msgstr "Remover um vínculo Bluetooth."

#: src/cli/main.cpp
msgid ""
"Re-advertise for ANCS so the iPhone shows its permission toggles again, "
"without removing the bond."
msgstr ""
"Anunciar novamente para o ANCS para que o iPhone mostre suas permissões de "
"novo, sem remover o vínculo."

#: src/cli/main.cpp
msgid "Connect to the iPhone over Bluetooth, or stop."
msgstr "Conectar ao iPhone por Bluetooth, ou parar."

#: src/cli/main.cpp
msgid "Turn notification mirroring on or off."
msgstr "Ativar ou desativar o espelhamento de notificações."

#: src/cli/main.cpp
msgid "Mirror notification titles and bodies, not just the app."
msgstr "Espelhar títulos e texto das notificações, não apenas o app."

#: src/cli/main.cpp
msgid "List mirrored iPhone notifications."
msgstr "Listar as notificações espelhadas do iPhone."

#: src/cli/main.cpp
msgid "Print a redacted Bluetooth report for a bug report."
msgstr "Imprimir um relatório Bluetooth sanitizado para um relato de erro."

#: src/cli/main.cpp
msgid "Accept a pending pairing request locally."
msgstr "Aceitar localmente uma solicitação de pareamento pendente."

#: src/cli/main.cpp
msgid "Send a pair_request over TCP to the daemon."
msgstr "Enviar um pair_request ao daemon por TCP."

