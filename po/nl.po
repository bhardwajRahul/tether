#: src/cli/main.cpp
msgid "yes"
msgstr "ja"

#: src/cli/main.cpp
msgid "no"
msgstr "nee"

#: src/cli/main.cpp
msgid "Show this help message."
msgstr "Deze hulptekst tonen."

#: src/cli/main.cpp
msgid "Print the tether version."
msgstr "De tether-versie tonen."

#: src/cli/main.cpp
msgid "Retrieve the current Wayland clipboard text."
msgstr "De huidige tekst van het Wayland-klembord ophalen."

#: src/cli/main.cpp
msgid "Take string input and copy it to the local Wayland clipboard."
msgstr ""
"Tekst van de invoer lezen en naar het lokale Wayland-klembord kopiëren."

#: src/cli/main.cpp
msgid "Send a file through tether."
msgstr "Een bestand via tether versturen."

#: src/cli/main.cpp
msgid "Start the browser Native Messaging Host proxy loop."
msgstr "De Native Messaging Host-proxylus van de browser starten."

#: src/cli/main.cpp
msgid "Scan the local network for tetherd instances via mDNS."
msgstr "Het lokale netwerk via mDNS op tetherd-instanties doorzoeken."

#: src/cli/main.cpp
msgid "Connect over TCP to daemon ip instead of UNIX Socket."
msgstr "Via TCP met het daemon-ip verbinden in plaats van via de UNIX-socket."

#: src/cli/main.cpp
msgid "Connect over TCP port (default 5134)."
msgstr "TCP-poort voor de verbinding (standaard 5134)."

#: src/cli/main.cpp
msgid "Discovery scan duration in milliseconds (default 3000)."
msgstr "Duur van het zoeken in milliseconden (standaard 3000)."

#: src/cli/main.cpp
msgid "List all paired connection devices."
msgstr "Alle gekoppelde apparaten tonen."

#: src/cli/main.cpp
msgid "Show the one-time system setup Bluetooth still needs."
msgstr "De eenmalige systeeminstelling tonen die Bluetooth nog nodig heeft."

#: src/cli/main.cpp
msgid "Show Bluetooth adapter capability and delivery mode."
msgstr "Mogelijkheden van de Bluetooth-adapter en de afleveringsmodus tonen."

#: src/cli/main.cpp
msgid "List Bluetooth devices known to BlueZ."
msgstr "Bluetooth-apparaten tonen die BlueZ kent."

#: src/cli/main.cpp
msgid "Show Bluetooth link and profile connection state."
msgstr "Status van de Bluetooth-verbinding en van de profielen tonen."

#: src/cli/main.cpp
msgid "List iPhone message conversations."
msgstr "Berichtgesprekken van de iPhone tonen."

#: src/cli/main.cpp
msgid "Show messages in one conversation."
msgstr "De berichten van één gesprek tonen."

#: src/cli/main.cpp
msgid "Reply in one conversation."
msgstr "In één gesprek antwoorden."

#: src/cli/main.cpp
msgid "List iPhone contacts, or search them by name or number."
msgstr "Contacten van de iPhone tonen, of erin zoeken op naam of nummer."

#: src/cli/main.cpp
msgid "Pair with an iPhone over Bluetooth."
msgstr "Een iPhone via Bluetooth koppelen."

#: src/cli/main.cpp
msgid ""
"Ask the iPhone to authenticate directly instead of connecting first. Tether "
"falls back to this on its own; use it to skip straight there."
msgstr ""
"Vraag de iPhone om zich direct te authenticeren in plaats van eerst te "
"verbinden. Tether valt hier vanzelf op terug; gebruik dit om er meteen "
"naartoe te gaan."

#: src/cli/main.cpp
msgid "Remove a Bluetooth bond."
msgstr "Een Bluetooth-koppeling verwijderen."

#: src/cli/main.cpp
msgid ""
"Re-advertise for ANCS so the iPhone shows its permission toggles again, "
"without removing the bond."
msgstr ""
"Opnieuw adverteren voor ANCS zodat de iPhone zijn machtigingen weer toont, "
"zonder de koppeling te verwijderen."

#: src/cli/main.cpp
msgid "Connect to the iPhone over Bluetooth, or stop."
msgstr "Met de iPhone via Bluetooth verbinden, of stoppen."

#: src/cli/main.cpp
msgid "Turn notification mirroring on or off."
msgstr "Het spiegelen van meldingen in- of uitschakelen."

#: src/cli/main.cpp
msgid "Mirror notification titles and bodies, not just the app."
msgstr "Titels en tekst van meldingen spiegelen, niet alleen de app."

#: src/cli/main.cpp
msgid ""
"How message history and contacts are kept on disk. Encrypted uses a key from "
"the desktop keyring; none deletes what is stored and keeps nothing further."
msgstr "Hoe berichtgeschiedenis en contacten op schijf worden bewaard. encrypted gebruikt een sleutel uit de sleutelbos van het bureaublad; none verwijdert wat is opgeslagen en bewaart verder niets."

#: src/cli/main.cpp
msgid "Choose which Bluetooth controller to use."
msgstr "Kiest welke Bluetooth-adapter wordt gebruikt."

#: src/cli/main.cpp
msgid "List mirrored iPhone notifications."
msgstr "Gespiegelde iPhone-meldingen tonen."

#: src/cli/main.cpp
msgid "Print a redacted Bluetooth report for a bug report."
msgstr "Een geschoond Bluetooth-rapport voor een foutmelding afdrukken."

#: src/cli/main.cpp
msgid ""
"Install the browser and mail extension's native messaging manifests for this "
"user. Needed only for portable builds; the distro packages install them "
"system-wide."
msgstr ""
"Installeert de native messaging-manifests van de browser- en mailextensie "
"voor deze gebruiker. Alleen nodig bij draagbare builds; de "
"distributiepakketten installeren ze systeembreed."

#: src/cli/main.cpp
msgid "Accept a pending pairing request locally."
msgstr "Een openstaand koppelverzoek lokaal accepteren."

#: src/cli/main.cpp
msgid "Send a pair_request over TCP to the daemon."
msgstr "Een pair_request via TCP naar de daemon sturen."

#: src/cli/main.cpp
msgid "tether - Wayland companion CLI"
msgstr "tether - Wayland-hulpprogramma voor de opdrachtregel"

#: src/cli/main.cpp
msgid "Options:"
msgstr "Opties:"

#: src/cli/main.cpp
msgid "Examples:"
msgstr "Voorbeelden:"

#: src/cli/main.cpp
#, c-format
msgid "Installed %s\n"
msgstr "Geïnstalleerd: %s\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"No browser or mail client profile was found for this user, so nothing was "
"installed. Start Firefox, Thunderbird, or Chromium once and run this again.\n"
msgstr ""
"Er is geen browser- of mailprofiel voor deze gebruiker gevonden, dus er is "
"niets geïnstalleerd. Start Firefox, Thunderbird of Chromium één keer en voer "
"dit opnieuw uit.\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"Restart the browser or mail client to pick this up.\n"
msgstr ""
"\n"
"Herstart de browser of het mailprogramma om dit te laten werken.\n"

