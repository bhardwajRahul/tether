msgstr "Bluetooth: niet beschikbaar (draait bluetoothd?)\n"

#: src/cli/main.cpp
#, c-format
msgid "Bluetooth setup is complete. Nothing to do.\n"
msgstr "De Bluetooth-instelling is voltooid. Er is niets te doen.\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"\n"
"%zu step left before the iPhone Bluetooth features work:\n"
msgid_plural ""
"\n"
"%zu steps left before the iPhone Bluetooth features work:\n"
msgstr[0] ""
"\n"
