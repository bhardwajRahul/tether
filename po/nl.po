#: src/cli/main.cpp
#, c++-format
msgid "Transfer Failed: {}"
msgstr "Overdracht mislukt: {}"

#: src/cli/main.cpp
msgid "A thread key is required, e.g. --bt-messages tel:+15551234567\n"
msgstr "Een gesprekssleutel is vereist, bijv. --bt-messages tel:+15551234567\n"

#: src/cli/main.cpp
msgid ""
"A conversation and a message are required, e.g. --bt-send tel:+15551234567 "
"\"hi\"\n"
msgstr ""
"Een gesprek en een bericht zijn vereist, bijv. --bt-send tel:+15551234567 "
"\"hoi\"\n"

#: src/cli/main.cpp
msgid "A Bluetooth address is required, e.g. --bt-pair AA:BB:CC:DD:EE:FF\n"
msgstr "Een Bluetooth-adres is vereist, bijv. --bt-pair AA:BB:CC:DD:EE:FF\n"

#: src/cli/main.cpp
msgid "Expected on or off, e.g. --bt-enable off\n"
msgstr "on of off verwacht, bijv. --bt-enable off\n"

#: src/cli/main.cpp
#, c-format
msgid "Bluetooth enabled.\n"
msgstr "Bluetooth ingeschakeld.\n"

#: src/cli/main.cpp
#, c-format
msgid ""
"Bluetooth disabled. Tether will not reconnect the iPhone. A link that is\n"
"already up stays up until you disconnect it or the phone goes out of range.\n"
msgstr ""
"Bluetooth uitgeschakeld. Tether verbindt de iPhone niet opnieuw. Een "
"verbinding\n"
"die al actief is blijft actief tot je hem verbreekt of de telefoon buiten "
"bereik raakt.\n"

#: src/cli/main.cpp
#, c++-format
msgid "Expected on or off, e.g. {} on\n"
msgstr "on of off verwacht, bijv. {} on\n"

#: src/cli/main.cpp
msgid "Notification contents enabled."
msgstr "Inhoud van meldingen ingeschakeld."

#: src/cli/main.cpp
msgid "Notification contents disabled."
msgstr "Inhoud van meldingen uitgeschakeld."

#: src/cli/main.cpp
msgid "Notification mirroring enabled."
msgstr "Spiegelen van meldingen ingeschakeld."

#: src/cli/main.cpp
msgid "Notification mirroring disabled."
msgstr "Spiegelen van meldingen uitgeschakeld."

#: src/cli/main.cpp
msgid "Expected encrypted, plaintext or none, e.g. --bt-retention encrypted\n"
msgstr "Verwacht encrypted, plaintext of none, bijv. --bt-retention encrypted\n"

#: src/cli/main.cpp
#, c-format
